# Copie para .env e preencha. O .env esta no .gitignore.
# Credenciais do Postgres LOCAL de desenvolvimento. O banco publicado (S-26)
# tem credenciais proprias, que nunca passam por aqui.
POSTGRES_DB=solar
POSTGRES_USER=solar
POSTGRES_PASSWORD=
# Chave de autorizacao para operacoes de privacidade/LGPD (DELETE /leads e DELETE /conversas).
SEGURANCA__CHAVEPRIVACIDADE=
# Senha inicial do supervisor semeado (supervisor.vinculado@solar.local) para
# entrar no painel do corretor. Aplicada so enquanto ele ainda nao tem senha.
SEMENTE__SENHASUPERVISOR=
